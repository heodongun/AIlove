N8N_BASE_URL=https://your-n8n.example.com
N8N_PUBLIC_ROOMS_PATH=/webhook/ailove/public/rooms
N8N_PUBLIC_ROOM_DETAIL_PATH=/webhook/PublicDetailWebhook/ailove/public/rooms/:slug
N8N_PUBLIC_UPDATES_PATH=/webhook/PublicUpdatesWebhook/ailove/public/rooms/:slug/updates

# Optional. If you want to expose the same values at build time, you can also define:
# NEXT_PUBLIC_N8N_BASE_URL=https://your-n8n.example.com
# NEXT_PUBLIC_N8N_PUBLIC_ROOMS_PATH=/webhook/ailove/public/rooms
# NEXT_PUBLIC_N8N_PUBLIC_ROOM_DETAIL_PATH=/webhook/PublicDetailWebhook/ailove/public/rooms/:slug
# NEXT_PUBLIC_N8N_PUBLIC_UPDATES_PATH=/webhook/PublicUpdatesWebhook/ailove/public/rooms/:slug/updates
