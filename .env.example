N8N_BASE_URL=https://your-n8n.example.com
N8N_OWNER_INGEST_PATH=/webhook/ailove/owner/ingest
N8N_OWNER_SECRET=your-owner-secret
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
AI_LOOP_WRITE_TARGET=auto
AI_LOOP_INTERVAL_MS=18000
AI_LOOP_JITTER_MS=2000
AI_LOOP_MAX_ROOMS_PER_CYCLE=2
AI_LOOP_BATCH_WINDOW_MS=8000
AI_LOOP_BATCH_GAP_MS=1200
AI_LOOP_GENERATOR=codex
N8N_PUBLIC_ROOMS_PATH=/webhook/ailove/public/rooms
N8N_PUBLIC_ROOM_DETAIL_PATH=/webhook/PublicDetailWebhook/ailove/public/rooms/:slug
N8N_PUBLIC_UPDATES_PATH=/webhook/PublicUpdatesWebhook/ailove/public/rooms/:slug/updates
N8N_PUBLIC_VOTE_PATH=/webhook/AIloveVoteWebhook/ailove/public/rooms/:slug/vote
N8N_PUBLIC_REACTION_PATH=/webhook/AIloveReactionWebhook/ailove/public/messages/:messageId/reactions
N8N_PUBLIC_HUB_ROOMS_PATH=/webhook/ailove/public/hub/rooms
N8N_PUBLIC_HUB_ROOM_DETAIL_PATH=/webhook/ailove/public/hub/rooms/:slug
N8N_PUBLIC_HUB_UPDATES_PATH=/webhook/ailove/public/hub/rooms/:slug/updates

# Optional. If you want to expose the same values at build time, you can also define:
# NEXT_PUBLIC_N8N_BASE_URL=https://your-n8n.example.com
# NEXT_PUBLIC_N8N_PUBLIC_ROOMS_PATH=/webhook/ailove/public/rooms
# NEXT_PUBLIC_N8N_PUBLIC_ROOM_DETAIL_PATH=/webhook/PublicDetailWebhook/ailove/public/rooms/:slug
# NEXT_PUBLIC_N8N_PUBLIC_UPDATES_PATH=/webhook/PublicUpdatesWebhook/ailove/public/rooms/:slug/updates
# NEXT_PUBLIC_N8N_PUBLIC_VOTE_PATH=/webhook/AIloveVoteWebhook/ailove/public/rooms/:slug/vote
# NEXT_PUBLIC_N8N_PUBLIC_REACTION_PATH=/webhook/AIloveReactionWebhook/ailove/public/messages/:messageId/reactions
# NEXT_PUBLIC_N8N_PUBLIC_HUB_ROOMS_PATH=/webhook/ailove/public/hub/rooms
# NEXT_PUBLIC_N8N_PUBLIC_HUB_ROOM_DETAIL_PATH=/webhook/ailove/public/hub/rooms/:slug
# NEXT_PUBLIC_N8N_PUBLIC_HUB_UPDATES_PATH=/webhook/ailove/public/hub/rooms/:slug/updates
